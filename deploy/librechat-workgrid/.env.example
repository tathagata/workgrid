# Copy this file to deploy/librechat/.env when running the kit with Work Grid.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_REVERSE_PROXY=

LIBRECHAT_CREDS_KEY=
LIBRECHAT_CREDS_IV=
LIBRECHAT_JWT_SECRET=
LIBRECHAT_JWT_REFRESH_SECRET=

MCP_SERVER_NAME=work-grid
MCP_SERVER_URL=http://work-grid:4173/api/mcp
MCP_SERVER_ADDRESS=work-grid:4173
MCP_SERVER_API_KEY=replace-with-a-random-secret
MCP_SERVER_DESCRIPTION="Read and update the Work Distribution Grid; board_get includes an MCP App board view."
LIBRECHAT_WELCOME="Work Grid is connected through MCP. Ask to show the current board."
MCP_SERVER_NO_PROXY=localhost,127.0.0.1,::1,mongodb,work-grid

WORKGRID_ALLOWED_HOST=work-grid

LIBRECHAT_IMAGE=ghcr.io/librechat-ai/librechat:v0.8.9-rc1
LIBRECHAT_PORT=3080
LIBRECHAT_SANDBOX_PORT=3081
LIBRECHAT_ALLOW_REGISTRATION=true

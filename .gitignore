# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# build output
/dist/
/outputs/
/work/
*.tsbuildinfo

# vite / wrangler / cloudflare
/.wrangler/
/.sites-runtime/
.vite/
.dev.vars
.dev.vars.*

# local databases
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# misc
.DS_Store
Thumbs.db
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
logs/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# editors
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# vercel
.vercel

# typescript
next-env.d.ts
